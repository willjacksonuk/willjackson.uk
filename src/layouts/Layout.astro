---
import "../styles/global.css";
import { Font } from "astro:assets";
import { SEO } from "astro-seo";

interface Props {
    title: string;
    description?: string;
    canonical?: string;
}

const { title, description, canonical = "https://willjackson.uk" } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />

        <!-- SEO -->
        <SEO
            title={title}
            description={description}
            canonical={canonical}
            openGraph={{
                basic: {
                    title: title,
                    type: "website",
                    image: "https://willjackson.uk/wj-opengraph.png",
                    url: canonical,
                },
                optional: {
                    description: description ?? "",
                },
            }}
            extend={{
                meta: [
                    {
                        name: "twitter:image",
                        content: "https://willjackson.uk/wj-opengraph.png",
                    },
                    {
                        name: "twitter:title",
                        content: title,
                    },
                    { name: "twitter:card", content: "summary_large_image" },
                    { name: "twitter:description", content: description ?? "" },
                ],
            }}
        />

        <!-- Schema -->
        <script type="application/ld+json">
            {
                "@context": "https://schema.org",
                "@type": "Person",
                "name": "Will Jackson",
                "url": "https://willjackson.uk",
                "email": "will@willjackson.uk",
                "jobTitle": "Developer and Digital Operations Lead",
                "sameAs": [
                    "https://github.com/willjacksonuk",
                    "https://linkedin.com/in/wejackson"
                ]
            }
        </script>

        <!-- Fonts -->
        <Font cssVariable="--font-body-src" preload />
        <Font cssVariable="--font-heading-src" preload />
        <Font cssVariable="--font-icons-src" />
    </head>

    <body class="flex min-h-screen flex-col bg-paper text-neutral-950 antialiased">
        <!-- Header: one row at every width -->
        <header
            class="sticky top-0 z-20 border-b border-stone-200 bg-paper/90 backdrop-blur"
        >
            <div
                class="mx-auto flex w-[min(calc(100%-2rem),1120px)] items-center justify-between gap-3 py-3 sm:py-4"
            >
                <a
                    href="/"
                    class="shrink-0 font-heading text-lg font-semibold tracking-tight text-teal-950 sm:text-2xl"
                >
                    Will Jackson
                </a>

                <nav
                    class="flex items-center gap-2.5 text-sm font-semibold sm:gap-6 sm:text-base"
                    aria-label="Primary navigation"
                >
                    <a class="transition hover:text-teal-700" href="/#work">Work</a>
                    <a class="transition hover:text-teal-700" href="/#about">About</a>
                    <a class="transition hover:text-teal-700" href="/#contact">Contact</a>
                    <a
                        class="rounded-md bg-teal-900 px-2.5 py-1 text-white transition hover:bg-teal-800 sm:px-4 sm:py-1.5"
                        href="/willjackson-cv-public.pdf"
                        target="_blank"
                        rel="noopener"
                        aria-label="CV (PDF, opens in a new tab)"
                    >
                        CV
                    </a>
                </nav>
            </div>
        </header>

        <!-- Main -->
        <main id="top" class="flex-1 pt-8">
            <slot />
        </main>

        <!-- Contact (home page only) and footer share one dark block -->
        <div class="bg-teal-950 text-teal-50">
            <slot name="contact" />

            <footer class="border-t border-teal-800 py-8 text-center text-sm text-teal-100">
                <div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
                    © {new Date().getFullYear()} Will Jackson
                    <p class="mt-2">
                        Built with Astro and Tailwind CSS.{" "}
                        <a
                            class="font-semibold text-white underline-offset-2 hover:underline"
                            href="https://github.com/willjacksonuk/willjackson.uk"
                            rel="noopener"
                            >View the source on GitHub</a
                        >
                    </p>
                </div>
            </footer>
        </div>

        <div class="zoom-overlay" aria-hidden="true">
            <img alt="" />
        </div>

        <script>
            import "../scripts/image-zoom.js";
        </script>
    </body>
</html>
