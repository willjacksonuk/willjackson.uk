---
import Layout from "../layouts/Layout.astro";
import Headshot from "../components/Headshot.astro";

import { projects } from "../data/projects";
import { skills } from "../data/skills";
import { contact } from "../data/contact";

const featured = projects.find((project) => project.featured);
const others = projects.filter((project) => !project.featured);

const kindLabel = { website: "Website", tool: "Tool" } as const;

const email = contact.find((link) => link.label === "Email");
const otherLinks = contact.filter((link) => link.label !== "Email");
---

<Layout
	title="Will Jackson - Developer and digital operations lead, Surrey"
	description="Surrey-based developer building websites, internal tools and automations, and running the systems behind a growing business."
>
	<div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
		<!-- Hero -->
		<section class="py-12 sm:py-16">
			<h1
				class="max-w-4xl font-heading text-4xl font-semibold tracking-tight text-neutral-950 sm:text-5xl lg:text-6xl"
			>
				Developer and digital operations lead based in Surrey.
			</h1>

			<p class="mt-6 max-w-3xl text-lg leading-8 text-neutral-700">
				I build websites, internal tools and automations - keeping the systems behind a business running smoothly. For over five years I’ve been the technical lead at a growing retailer, overseeing e-commerce, IT and data systems. Before that, I spent seven years supporting litigation and property solicitors, using specialist document systems and assisting with complex e-disclosure workflows.
			</p>

			<div class="mt-8 flex flex-col gap-4 sm:flex-row">
				<a
					class="inline-flex w-full justify-center rounded-lg border border-teal-800 bg-teal-800 px-6 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-teal-900 hover:shadow-md sm:w-auto"
					href="#work"
				>
					View work
				</a>

				<a
					class="inline-flex w-full justify-center rounded-lg border border-teal-800 px-6 py-3 font-semibold text-teal-800 transition hover:-translate-y-0.5 hover:bg-white hover:shadow-md sm:w-auto"
					href="#contact"
				>
					Contact me
				</a>
			</div>

			<p
				class="mt-10 flex max-w-3xl items-baseline gap-4 border-l-4 border-teal-700 pl-4"
			>
				<span class="font-heading text-4xl font-semibold text-teal-800">95%</span>
				<span class="text-neutral-700">
					organic search growth over three years at Woven & Woods
				</span>
			</p>
		</section>

		<!-- Work -->
		<section id="work" class="scroll-mt-20 py-12">
			<h2
				class="font-heading text-4xl font-semibold tracking-tight text-teal-900"
			>
				Work
			</h2>

			{
				featured && (
					<article class="group relative mt-8 grid overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition focus-within:ring-2 focus-within:ring-teal-700 hover:-translate-y-0.5 hover:shadow-md lg:grid-cols-[3fr_2fr]">
						<img
							src={featured.image.src}
							width={featured.image.width}
							height={featured.image.height}
							alt={featured.imageAlt}
							class="aspect-video h-full w-full border-b border-stone-200 object-cover object-left-top lg:aspect-auto lg:border-r lg:border-b-0"
						/>

						<div class="flex flex-col p-6 sm:p-8">
							<p class="text-sm font-semibold tracking-wide text-teal-800 uppercase">
								Featured · {kindLabel[featured.kind]}
							</p>

							<h3 class="mt-2 font-heading text-3xl font-semibold text-neutral-950">
								<a
									href={featured.caseStudy}
									class="after:absolute after:inset-0 focus:outline-none"
								>
									{featured.title}
								</a>
							</h3>

							<p class="mt-2 font-semibold text-stone-600">{featured.meta}</p>

							<p class="mt-4 text-lg leading-8 text-neutral-700">
								{featured.summary}
							</p>

							<div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-2 pt-6">
								<span class="font-semibold text-teal-800 group-hover:underline">
									Read the case study →
								</span>

								{featured.link && (
									<a
										class="relative z-10 font-semibold text-stone-600 hover:text-teal-800 hover:underline"
										href={featured.link}
										target="_blank"
										rel="noopener"
									>
										Visit site ↗
									</a>
								)}
							</div>
						</div>
					</article>
				)
			}

			<div class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				{
					others.map((project) => (
						<article class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition focus-within:ring-2 focus-within:ring-teal-700 hover:-translate-y-0.5 hover:shadow-md">
							<img
								src={project.image.src}
								width={project.image.width}
								height={project.image.height}
								alt={project.imageAlt}
								class="aspect-video w-full border-b border-stone-200 object-cover object-top"
								loading="lazy"
							/>

							<div class="flex flex-1 flex-col p-6">
								<p class="text-sm font-semibold tracking-wide text-teal-800 uppercase">
									{kindLabel[project.kind]}
								</p>

								<h3 class="mt-1 font-heading text-2xl font-semibold text-neutral-950">
									<a
										href={project.caseStudy}
										class="after:absolute after:inset-0 focus:outline-none"
									>
										{project.title}
									</a>
								</h3>

								<p class="mt-2 text-sm font-semibold text-stone-600">
									{project.meta}
								</p>

								<p class="mt-3 text-neutral-700">{project.summary}</p>

								<div class="mt-auto flex flex-wrap items-center gap-x-6 gap-y-2 pt-5">
									<span class="font-semibold text-teal-800 group-hover:underline">
										Read the case study →
									</span>

									{project.link && (
										<a
											class="relative z-10 font-semibold text-stone-600 hover:text-teal-800 hover:underline"
											href={project.link}
											target="_blank"
											rel="noopener"
										>
											Visit site ↗
										</a>
									)}
								</div>
							</div>
						</article>
					))
				}
			</div>
		</section>

		<!-- About -->
		<section id="about" class="scroll-mt-20 py-12">
			<h2
				class="font-heading text-4xl font-semibold tracking-tight text-teal-900"
			>
				About
			</h2>

			<div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
				<Headshot />

				<div
					class="max-w-3xl space-y-4 text-lg leading-8 text-neutral-700 [&_a]:text-teal-800 [&_a]:underline [&_a]:underline-offset-2 [&_a:hover]:text-teal-950"
				>
					<p>
						At <a href="https://wovenandwoods.com" rel="noopener">Woven & Woods</a>, I’m the company’s first and only technical hire. Since 2021 I’ve built and run its websites, product data and IT as the business has grown from one showroom to two, and from four people to twelve. My work covers custom WordPress and WooCommerce development, internal tools and automation, hardware and networking, hosting, technical SEO and analytics, supporting a catalogue of 800+ ranges from more than 60 manufacturers.
					</p>

					<p>
						My time working in law firms shapes how I work. Supporting solicitors in commercial litigation, probate disputes and property work, I saw how much a busy team relies on its systems, and how much time is lost when they get in the way. I became the person colleagues asked for help with the document systems, and assisted with e-disclosure on litigation matters. Now I build websites and tools that are fast, easy to manage and useful to the people who run them every day.
					</p>

					<p>
						Outside of work, I enjoy <a
							href="https://www.flickr.com/photos/willmx/"
							rel="noopener">photography</a
						>, <a href="https://recipes.willjackson.uk" rel="noopener"
							>trying out new recipes</a
						> and exploring the Surrey countryside. I also co-host a <a
							href="https://thegallimaufry.show"
							rel="noopener">history podcast</a
						>.
					</p>
				</div>
			</div>
		</section>

		<!-- Technical skills -->
		<section class="py-12">
			<h2
				class="font-heading text-4xl font-semibold tracking-tight text-teal-900"
			>
				Technical skills
			</h2>

			<dl class="mt-8 grid gap-x-12 gap-y-8 md:grid-cols-2">
				{
					skills.map((group) => (
						<div>
							<dt class="font-semibold text-neutral-950">{group.title}</dt>
							<dd class="mt-2 leading-7 text-neutral-700">{group.skills}</dd>
						</div>
					))
				}
			</dl>
		</section>
	</div>

	<!-- Contact: shares the dark block with the footer (see Layout.astro) -->
	<section id="contact" slot="contact" class="scroll-mt-20 py-16">
		<div class="mx-auto w-[min(calc(100%-2rem),1120px)]">
			<h2 class="font-heading text-4xl font-semibold tracking-tight text-white">
				Contact
			</h2>

			<p class="mt-4 max-w-2xl text-lg leading-8 text-teal-50">
				I’m always happy to talk about websites, systems, automation or
				anything in between. Email is the best way to reach me.
			</p>

			{
				email && (
					<a
						class="mt-8 inline-flex w-full justify-center rounded-lg bg-white px-8 py-4 text-lg font-semibold text-teal-950 transition hover:-translate-y-0.5 hover:bg-teal-50 hover:shadow-lg sm:w-auto"
						href={email.href}
					>
						Email me
					</a>
				)
			}

			{email && <p class="mt-3 text-teal-100">{email.text}</p>}

			<ul class="mt-8 flex flex-wrap gap-x-8 gap-y-3 font-semibold">
				{
					otherLinks.map((link) => (
						<li>
							<a
								class="text-white underline decoration-teal-400 underline-offset-4 hover:decoration-white"
								href={link.href}
								target="_blank"
								rel="noopener"
								aria-label={link.ariaLabel}
							>
								{link.label === "CV" ? "CV (PDF)" : link.label}
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>
</Layout>
