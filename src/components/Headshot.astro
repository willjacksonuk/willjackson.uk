---
// A small round headshot. Until there's a photo, it shows "WJ" in a teal
// circle. To use a photo, put it in src/assets/images/ and pass it in:
//   import photo from "../assets/images/headshot.jpg";
//   <Headshot image={photo} />
import type { ImageMetadata } from "astro";

interface Props {
	image?: ImageMetadata;
	alt?: string;
	class?: string;
}

const { image, alt = "Will Jackson", class: className } = Astro.props;
---

{
	image ? (
		<img
			src={image.src}
			width={image.width}
			height={image.height}
			alt={alt}
			class:list={["size-24 shrink-0 rounded-full object-cover sm:size-28", className]}
		/>
	) : (
		<div
			class:list={[
				"flex size-24 shrink-0 items-center justify-center rounded-full bg-teal-900 font-heading text-3xl font-semibold text-teal-50 sm:size-28",
				className,
			]}
			role="img"
			aria-label="Photo of Will Jackson coming soon"
		>
			WJ
		</div>
	)
}
