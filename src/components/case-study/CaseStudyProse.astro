---
// A full-width text section with a heading. Put <p> tags in the slot.
interface Props {
	heading: string;
}

const { heading } = Astro.props;
---

<section class="py-12">
	<h2 class="font-heading text-4xl font-bold tracking-tight text-teal-900">
		{heading}
	</h2>

	<div class="mt-6 max-w-3xl space-y-4 text-lg leading-8 text-neutral-600">
		<slot />
	</div>
</section>
