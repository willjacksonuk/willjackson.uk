---
// A boxed note with a heading, for shorter points. Put two or three side by
// side in a CaseStudyCards grid. Put <p> tags in the slot.
interface Props {
	heading: string;
}

const { heading } = Astro.props;
---

<div class="rounded-lg border border-stone-400 bg-white p-6 shadow-sm">
	<h2 class="font-heading text-2xl font-bold text-neutral-950">
		{heading}
	</h2>

	<div class="mt-4 space-y-4 text-neutral-600">
		<slot />
	</div>
</div>
