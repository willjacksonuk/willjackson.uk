---
// A text section beside a screenshot. Put <p> tags in the slot.
// Set `reverse` to put the screenshot on the left; alternate it between
// sections so the page zigzags.
import type { ImageMetadata } from "astro";

interface Props {
	heading: string;
	image: ImageMetadata;
	imageAlt: string;
	reverse?: boolean;
}

const { heading, image, imageAlt, reverse = false } = Astro.props;
---

<section class="py-12">
	<div class="grid items-center gap-8 lg:grid-cols-2">
		<div class:list={[reverse && "lg:order-2"]}>
			<h2
				class="font-heading text-3xl font-bold tracking-tight text-teal-900"
			>
				{heading}
			</h2>

			<div class="mt-6 space-y-4 text-lg leading-8 text-neutral-600">
				<slot />
			</div>
		</div>

		<div
			class="overflow-hidden rounded-lg border border-stone-400 bg-white p-3 shadow-sm"
		>
			<img
				src={image.src}
				width={image.width}
				height={image.height}
				alt={imageAlt}
				class="zoomable-img w-full rounded-lg"
				loading="lazy"
			/>
		</div>
	</div>
</section>
